# Local SQLite database path (used by later implementation phases).
FLOWGUARD_DATABASE_URL=sqlite:///./flowguard.db

# Workflow configuration directory (used by later implementation phases).
FLOWGUARD_WORKFLOW_CONFIG_DIR=configs/workflows

# Application environment.
FLOWGUARD_ENV=development

# Optional demo admin credential. Set a local value before running the API, e.g.
# $env:FLOWGUARD_ADMIN_TOKEN = "local-demo-token-change-me"
# Never commit a real credential. Protected endpoints return 503 if this is unset.
FLOWGUARD_ADMIN_TOKEN=

# Phase 4 deterministic server-side dependency simulation.
FLOWGUARD_SIMULATOR_SCENARIO=SUCCESS
FLOWGUARD_SIMULATOR_FAIL_ATTEMPTS=1

# Max attempts includes the first external attempt; delay grows exponentially and is capped.
FLOWGUARD_RETRY_MAX_ATTEMPTS=3
FLOWGUARD_RETRY_BASE_DELAY_SECONDS=1
FLOWGUARD_RETRY_MAX_DELAY_SECONDS=60
FLOWGUARD_EXECUTION_LEASE_SECONDS=120
